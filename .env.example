# Public site URL (used in sitemap.xml and robots.txt). Example: https://www.yourdomain.com
APP_URL=""

# First admin account, created only when the database has no users.
# If ADMIN_PASSWORD is shorter than 12 characters a random one is generated and printed once in the server log.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Site Administrator"

# Optional. If unset, a random secret is generated and stored in the database.
SESSION_SECRET=""
